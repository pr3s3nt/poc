{
  "key": "${bootstrap.definitionPrefix}-mongodb",
  "name": "${bootstrap.definitionName} mongodb",
  "resourceType": "mongodb",
  "driverType": "terraform",
  "driverInputs": {
    "values": {
      "variables": {
        "namespace": "${resources['k8s-namespace.default#environments.@app.@env'].outputs.name}",
        "database": "${bootstrap.mongodbDatabase}",
        "username": "${bootstrap.mongodbUsername}",
        "image": "${bootstrap.mongodbImage}",
        "storage": "${bootstrap.mongodbStorage}",
        "storage_class": "${bootstrap.mongodbStorageClass}",
        "image_pull_secret_name": "${bootstrap.mongodbImagePullSecretName}",
        "root_username": "${bootstrap.mongodbRootUsername}"
      },
      "source": {
        "source_id": "${bootstrap.moduleSourceId}",
        "module_id": "${bootstrap.mongodbModuleId}",
        "revision": "${bootstrap.modulesCommit}",
        "subdirectory": "${bootstrap.mongodbModulePath}",
        "content_sha256": "${bootstrap.mongodbModuleSHA256}"
      },
      "input_mapping": {
        "image": {
          "param": "image"
        },
        "database": {
          "param": "database"
        },
        "username": {
          "param": "username"
        },
        "storage": {
          "param": "storage"
        }
      },
      "output_mapping": {
        "host": "host",
        "port": "port",
        "database": "database",
        "username": "username",
        "claimName": "claimName",
        "namespace": "namespace",
        "password": "password",
        "connection": "connection"
      },
      "provider_bindings": {
        "kubernetes": {
          "target": "resource",
          "resource_ref": "k8s-cluster.${bootstrap.targetClass}#environments.@app.@env"
        }
      }
    }
  },
  "provision": {},
  "criteria": [
    {
      "env_type": "${bootstrap.environmentType}",
      "class": "in-cluster"
    }
  ]
}
