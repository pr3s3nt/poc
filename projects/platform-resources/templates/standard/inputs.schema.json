{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "team": {
      "type": "string",
      "title": "Team",
      "description": "Added as the example.com/team label of the Deployment, its Pods and the Service.",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "defaultReplicas": {
      "type": "integer",
      "title": "Default replicas",
      "description": "Replicas of a workload whose Workload declares none.",
      "minimum": 1,
      "maximum": 20,
      "default": 1
    },
    "runAsNonRoot": {
      "type": "boolean",
      "title": "Run as non-root",
      "description": "Sets the Pod securityContext runAsNonRoot field.",
      "default": false
    },
    "httpRouteEnabled": {
      "type": "boolean",
      "title": "Enable HTTPRoute",
      "default": false
    },
    "httpRouteGatewayName": {
      "type": "string",
      "title": "Existing Gateway name",
      "default": "",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "maxLength": 253
    },
    "httpRouteGatewayNamespace": {
      "type": "string",
      "title": "Existing Gateway namespace",
      "default": "",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "maxLength": 63
    },
    "httpRouteGatewaySectionName": {
      "type": "string",
      "title": "Gateway listener (optional)",
      "default": "",
      "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
      "maxLength": 63
    }
  }
}
