{
  "uid": "orchestrator-workloads",
  "title": "Orchestrator workloads (development example)",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "orchestrator",
    "development-example"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "cluster_uid",
        "label": "cluster_uid",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info, cluster_uid)",
          "refId": "cluster_uid"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "namespace",
        "label": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info{cluster_uid=\"$cluster_uid\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "workload",
        "label": "workload",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(kube_deployment_labels{cluster_uid=\"$cluster_uid\",namespace=\"$namespace\"}, deployment)",
          "refId": "workload"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU (mCPU)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{cluster_uid=\"$cluster_uid\",namespace=\"$namespace\",pod=~\"$workload-.*\",container!=\"\",container!=\"POD\"}[5m])) * 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory (bytes)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{cluster_uid=\"$cluster_uid\",namespace=\"$namespace\",pod=~\"$workload-.*\",container!=\"\",container!=\"POD\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Ready replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_deployment_status_replicas_available{cluster_uid=\"$cluster_uid\",namespace=\"$namespace\",deployment=\"$workload\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Restarts (5m increase)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{cluster_uid=\"$cluster_uid\",namespace=\"$namespace\",pod=~\"$workload-.*\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      }
    }
  ]
}
