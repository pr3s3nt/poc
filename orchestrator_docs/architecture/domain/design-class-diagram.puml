@startuml
title Orchestrator - Consolidated final V06 Design (ADR-017)
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members

package "Application Services" {
  class AuthenticationService {
    +SignIn(ctx, cmd): Session
    +SignOut(ctx, token)
  }
  class ApplicationService {
    +CreateApplication(ctx, cmd): Application
  }
  class ResourceTypeService {
    +RegisterResourceType(ctx, cmd): ResourceType
  }
  class ResourceDefinitionService {
    +RegisterResourceDefinition(ctx, cmd): ResourceDefinition
    +UpdateResourceDefinition(ctx, key, expectedVersion, cmd): ResourceDefinition
    +ListRenderBundles(): SafeBundleMetadata[]
    +PreviewMatching(ctx, org, query): MatchingPreview
    +InspectTerraformModule(ctx, org, request): CapabilityMetadata
  }
  class ConnectionService {
    +RenameAccount(ctx, org, key, version, name): Connection
    +VerifyAccount(ctx, org, key, version): Connection
    +ReplaceAccountCredential(ctx, org, key, version, cmd): Connection
    +InspectKubeconfig(ctx, org, document): ContextMetadata
    +RegisterAWSDriverAccount(ctx, cmd): Connection
    +RegisterKubeconfig(ctx, cmd): Connection
  }
  class ConfigurationService {
    +ListKeys(ctx, scope): SafeConfigurationView
    +RenameKey(ctx, scope, guards, updateReferences): SafeConfigurationView
  }
  class LosslessScoreReconstruction
  class PreviewService {
    +PreviewDeployment(ctx, query): DeploymentPreview
  }
  class DeploymentService {
    +DeployWorkload(ctx, cmd): DeploymentResult
    +UpdateWorkload(ctx, cmd): DeploymentResult
    +RemoveWorkload(ctx, cmd): DeploymentResult
  }
  class ResourceProvisioningService {
    +Provision(ctx, request): ProvisionResult
  }
  class DeploymentQueryService {
    +GetDeployment(ctx, query): DeploymentView
  }
}

package "Planning" {
  class PlanningService {
    +Plan(ctx, request): DeploymentPlan
  }
  class ScoreConverter
  class WorkloadSpecValidator
  class BeforeStateValidator {
    +Validate(current, workloadID, before)
  }
  class DeltaBuilder {
    +Build(current, workloadID, before, after): DeltaResult
  }
  class ResourceDescriptorParser {
    +ParseDescriptorText(raw, current, context): ResourceDescriptor
  }
  class ResourceGraphBuilder
  class GraphExpander
  class DefinitionMatcher
  class DriverContractInspector
  class BatchScheduler
  class ActiveResourceClassifier
}

package "Execution" {
  class ActiveResourceResolver
  class OutputBindingResolver
  class ExecutorRegistry
  class OutputContractValidator
  interface ResourceExecutor {
    +Execute(ctx, action, instance, inputs, stateRef): ExecutionResult
  }
  interface WorkloadRenderer {
    +Render(ctx, request): List<Manifest>
  }
  interface WorkloadDeployer {
    +Apply(ctx, target, manifests)
    +Delete(ctx, target, workload)
    +WaitReady(ctx, target, workloads)
  }
  interface PublicRouteManager {
    +Reconcile(ctx, target, route)
  }
  class TerraformExecutor
  class ConnectionCredentialResolver
  class ExistingClusterAdapter
}

package "Environment Settings and Operations" {
 class SecretStoreConnection <<aggregate>> {
  +OrganizationKey: string
  +StoreKey: string
  +Provider: VaultKVv2
  +CredentialRef: opaque
 }
 class ComposeSecretStoreBootstrap
 class SecretStoreResolver
 class EnvironmentSettingsService
 class EnvironmentOperation <<entity>> {
  +Owner: string
  +Stage: string
  +PinnedVersions: object
  +Fence: int64
  +Status: OperationStatus
  +ResourcePins: object
 }
}
package "Domain" {
  class Organization <<entity>>
  class UserAccount <<aggregate>> {
    +OrganizationID: OrganizationID
    +Role: UserRole
    +Status: AccountStatus
  }
  class Session <<aggregate>> {
    +TokenHash: string
    +ExpiresAt: time
    +Revoke()
  }
  class Application <<aggregate>> {
    +ID: ApplicationID
    +Name: string
    +Subdomain: string
    +Key: string
    +OrganizationKey: string
    +Version: int64
  }
  class Environment <<aggregate>> {
    +ID: EnvironmentID
    +DesiredEndpoint(): Hostname
    +SecretStoreKey: string
    +TargetGeneration: int64
    +ActiveOperationID: string
    +InfrastructureScope: InfrastructureScope
    +Namespace: NamespaceIdentity
    +Version: int64
  }
  class Connection <<aggregate>> {
    +Version: int64
    +AccountType(): AWS or INTERNAL
    +Name: string
    +AuthenticationType: ConnectionAuthenticationType
    +Kind: ConnectionKind
    +SecretRef: SecretReference
    +Status: ConnectionStatus
  }
  class ResourceType <<aggregate>>
  class ResourceDefinition <<aggregate>> {
    +Key: string {immutable}
    +ResourceType: string {immutable}
    +Name: string
    +DriverAccount: string
    +Version: int64
  }
  class MatchingCriterion <<entity>>
  class DeploymentSet <<entity>>
  class Deployment <<aggregate>> {
    +Status: DeploymentStatus
    +StartProvisioning(plan)
    +StartDeploying()
    +Succeed()
  }
  class DeploymentPlan <<entity>>
  class DeploymentDeltaSnapshot <<entity>> {
    +ID: DeltaSnapshotID
    +Metadata: DeltaSnapshotMetadata
    +Modules: ModuleDelta
    +Shared: List<JSONPatchOperation>
  }
  class ModuleDelta <<value>>
  class JSONPatchOperation <<value>>
  class ContainerResourceRequirements <<value>> {
    +Requests: ComputeResources
    +Limits: ComputeResources
  }
  class ComputeResources <<value>> {
    +CPU: string
    +Memory: string
  }
  class ResourceGraph <<value>>
  class ResourceNode <<value>>
  class ResourceEdge <<value>>
  class ProvisionBatch <<value>>
  class ActiveResource <<aggregate>> {
    +Descriptor: ResourceDescriptor
    +Scope: ResourceScope
    +Status: ResourceStatus
    +MarkReady(state, outputs)
    +MarkUnreferenced()
  }
  class WorkloadInstance <<aggregate>>
}

package "Ports" {
  interface PasswordHasher {
    +Verify(password, hash): bool
  }
  interface UserAccountRepository
  interface SessionRepository
  interface AtomicDesiredRename {
    +Commit(ctx, configEnvDraftGuards, revision, drafts)
  }
  interface ApplicationRepository
  interface EnvironmentRepository
  interface ConnectionRepository
  interface ResourceTypeRepository
  interface ResourceDefinitionRepository
  interface DeploymentSetRepository
  interface DeploymentDeltaSnapshotRepository
  interface DeploymentRepository
  interface ActiveResourceRepository
  interface DeploymentResourceRepository
  interface WorkloadInstanceRepository
  interface SecretStore
  interface ConnectionCredentialStore {
    +Put(ctx, org, key, credential): Reference
    +Get(ctx, org, key, ref): Credential
    +Delete(ctx, org, key, ref)
  }
}

ConfigurationService --> LosslessScoreReconstruction : prepare desired references
ConfigurationService --> AtomicDesiredRename : one metadata transaction
ConfigurationService --> EnvironmentRepository : consistent scoped snapshot
PreviewService --> PlanningService
DeploymentService --> PlanningService
DeploymentService --> ResourceProvisioningService
DeploymentService --> OutputBindingResolver
DeploymentService --> WorkloadRenderer
DeploymentService --> WorkloadDeployer
DeploymentService --> PublicRouteManager
ResourceProvisioningService --> ActiveResourceResolver
ResourceProvisioningService --> OutputBindingResolver
ResourceProvisioningService --> ExecutorRegistry
ResourceProvisioningService --> OutputContractValidator
ExecutorRegistry --> ResourceExecutor
ResourceExecutor <|.. TerraformExecutor
ResourceExecutor <|.. ExistingClusterAdapter

PlanningService --> ScoreConverter
PlanningService --> WorkloadSpecValidator
PlanningService --> BeforeStateValidator
PlanningService --> DeltaBuilder
PlanningService --> ResourceDescriptorParser
PlanningService --> ResourceGraphBuilder
PlanningService --> GraphExpander
PlanningService --> DefinitionMatcher
PlanningService --> DriverContractInspector
PlanningService --> BatchScheduler
PlanningService --> ActiveResourceClassifier

Organization "1" o-- "0..*" Application
Application "1" *-- "0..*" Environment
Environment "1" --> "1" DeploymentSet : current
Environment "1" o-- "0..*" Deployment
Deployment "1" *-- "1" DeploymentPlan
Deployment "1" *-- "1" DeploymentDeltaSnapshot
DeploymentDeltaSnapshot "1" *-- "1" ModuleDelta
DeploymentDeltaSnapshot "1" *-- "0..*" JSONPatchOperation
DeploymentPlan "1" *-- "1" ResourceGraph
ResourceGraph "1" *-- "0..*" ResourceNode
ResourceGraph "1" *-- "0..*" ResourceEdge
DeploymentPlan "1" *-- "0..*" ProvisionBatch
ResourceDefinition "1" *-- "1..*" MatchingCriterion
ResourceDefinition --> ResourceType
ActiveResource --> ResourceDefinition
Environment "1" o-- "0..*" WorkloadInstance
WorkloadRenderer ..> ContainerResourceRequirements
ContainerResourceRequirements *-- ComputeResources

ApplicationService --> ApplicationRepository
ApplicationService --> EnvironmentRepository
ApplicationService --> ConnectionRepository
ApplicationService --> EnvironmentRepository : versioned CAS
ApplicationService --> ConnectionRepository : scoped validation
AuthenticationService --> PasswordHasher
AuthenticationService --> UserAccountRepository
AuthenticationService --> SessionRepository
Organization "1" o-- "0..*" UserAccount
UserAccount "1" o-- "0..*" Session
ResourceTypeService --> ResourceTypeRepository
ResourceDefinitionService --> ResourceDefinitionRepository
ResourceDefinitionService --> ResourceTypeRepository
ConnectionService --> ConnectionRepository
ConnectionService --> ConnectionCredentialStore
ConnectionCredentialResolver --> ConnectionCredentialStore
ConnectionCredentialResolver --> ConnectionRepository
ExistingClusterAdapter --> ConnectionCredentialResolver
WorkloadDeployer --> ConnectionCredentialResolver
DeploymentService --> EnvironmentRepository
DeploymentService --> ApplicationRepository
DeploymentService --> DeploymentSetRepository
DeploymentService --> DeploymentDeltaSnapshotRepository
DeploymentService --> DeploymentRepository
DeploymentService --> WorkloadInstanceRepository
ResourceProvisioningService --> ActiveResourceRepository
ResourceProvisioningService --> DeploymentResourceRepository
DeploymentQueryService --> DeploymentRepository
DeploymentQueryService --> ActiveResourceRepository
class RenderBundle <<value>> {
  +ID: string
  +Version: string
  +BinaryDigest: string
  +Digest: string
}
class RenderingSelection <<value>> {
  +DefinitionKey: string
  +DefinitionHash: string
  +DriverType: DriverType
}
interface RenderPreflight {
  +ValidateSelection(ctx, selected)
}
class ScoreK8sRenderer <<adapter>> {
  +Render(ctx, request): List<Manifest>
  +Bundles(): Map
}
PlanningService ..> RenderBundle : startup catalog
ResourceDefinitionService ..> RenderBundle : validation + fingerprint
RenderingSelection *-- RenderBundle
DeploymentPlan *-- RenderingSelection : per workload
ScoreK8sRenderer ..|> WorkloadRenderer
ScoreK8sRenderer ..|> RenderPreflight
DeploymentService --> RenderPreflight : before UC-08
ComposeSecretStoreBootstrap --> SecretStoreConnection : verified managed registration
Environment --> SecretStoreConnection : versioned selection
Environment "1" o-- "0..*" EnvironmentOperation
EnvironmentSettingsService --> SecretStoreResolver
EnvironmentSettingsService --> EnvironmentRepository : CAS + claim
note right of GraphExpander
ADR-017: expand matched Definition references/rules to fixed point.
Each winning Definition selects its own account/region.
Consumers inherit typed cluster through explicit references.
No profile enrichment or Environment/system/default target.
Actual gate delivery status belongs to CURRENT_STATE.
end note

ResourceDefinitionService ..> DefinitionMatcher : five-field ranking + winner account guard
class TerraformModuleBundle <<entity>> {
  +Revision: immutable
  +ContentSHA256: string
  +ProviderPins: object
  +InputOutputContract: object
  +SourceURL: optional safe HTTPS origin
}
class ModuleBundleResolver <<adapter>>
class ModuleSourcePolicy <<control>>
class TerraformResourceInstance <<aggregate>> {
  +StateKey: opaque
  +TargetGeneration: int64
  +PhysicalIntent: safe object
  +Ownership: ResourceOwnership
}
class TerraformStateSnapshot <<restricted integration state>>
class TerraformStateLock <<entity>>
class TerraformResourceAttempt <<entity>>
class TerraformStateBackend <<boundary>>
class CleanupPlanner <<control>>
class ResourceCleanupService <<control>>
interface TerraformStateRepository
interface ResourceInstanceRepository
interface ResourceAttemptRepository
ResourceDefinition --> TerraformModuleBundle
ResourceDefinitionService --> ModuleSourcePolicy
ResourceDefinitionService --> ModuleBundleResolver
ModuleBundleResolver ..> TerraformModuleBundle
PlanningService ..> TerraformModuleBundle : metadata only
ResourceProvisioningService --> ResourceInstanceRepository : persist intent before execution
ResourceProvisioningService --> ResourceAttemptRepository
TerraformResourceInstance "1" o-- "0..1" TerraformStateSnapshot
TerraformResourceInstance "1" o-- "0..1" TerraformStateLock
TerraformResourceInstance "1" o-- "0..*" TerraformResourceAttempt
TerraformResourceInstance --> Environment : owner/generation
TerraformResourceInstance --> ActiveResource : result association
TerraformExecutor --> TerraformStateBackend
TerraformExecutor --> ConnectionCredentialResolver
TerraformStateBackend --> TerraformStateRepository : encrypted state / lock CAS
TerraformStateBackend --> EnvironmentOperation : current owner/fencing checks
CleanupPlanner --> ResourceInstanceRepository : pinned candidates / selected set
ResourceCleanupService --> CleanupPlanner : confirmed scope only
ResourceCleanupService --> ResourceInstanceRepository
ResourceCleanupService --> ResourceAttemptRepository
ResourceCleanupService --> TerraformExecutor : explicit DESTROY
ResourceCleanupService --> EnvironmentOperation : separate claim
class WorkloadPlacement <<value>> {
  +WorkloadClass: string
  +ClusterDescriptor: string
  +NamespaceDescriptor: string
  +ScopedTargetPin: opaque
}
class WorkloadPlacementResolver <<control>>
PlanningService --> WorkloadPlacementResolver : selected Definition references
WorkloadPlacementResolver --> WorkloadPlacement : validate and pin per consumer
note right of WorkloadPlacement
One-cluster Candidate Set capability guard;
model supports independent resource targets.
No credentials in public projection.
end note
class ClusterTargetIdentity <<value>> {
  +Provider: Internal or EKS
  +Descriptor: string
  +OrganizationAccountVersion: opaque
  +ClusterNameRegion: safe identity
}
WorkloadPlacement *-- ClusterTargetIdentity
note right of ClusterTargetIdentity
ADR-017: unknown typed provenance at Preview.
Resolve EKS after provision; fresh scoped auth per invocation.
API/auth/network/Ready capacity before consumers.
No token, kubeconfig, temporary path or host fallback.
end note
@enduml
