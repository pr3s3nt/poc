@startuml
title Orchestrator Database ERD — Required final V06 schema - ADR-014/017
hide circle
skinparam linetype ortho

entity schema_baseline {
  * singleton : boolean <<PK,true>>
  --
  baseline : text
  baseline_sha256 : text
  catalog_sha256 : text
  installation_id : uuid
  schema_name : text
  created_at : timestamptz
}
note right of schema_baseline
  Technical baseline identity; no migration ledger.
  Owner setup on empty schema only.
  Runtime validation without DDL; separate Console/State logins.
end note

entity organizations {
  * id : uuid <<PK>>
  --
  organization_key : text <<UQ>>
  name : text
}
note right of organizations
  Final V06.08: no default deployment Connection marker.
  Driver Accounts belong to Organization and are selected by Definitions.
end note
entity user_accounts {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  username : text <<UQ>>
  password_hash : text
  role : text
  status : text
}
entity sessions {
  * id : uuid <<PK>>
  * user_account_id : uuid <<FK>>
  --
  token_hash : text <<UQ>>
  expires_at : timestamptz
  revoked_at : timestamptz
}
entity connections {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  connection_key : text
  version : bigint <<CAS,positive>>
  name : text
  authentication_type : text
  kind : text
  secret_ref : text
  status : text
  config : jsonb
}
entity secret_store_connections {
 * id : uuid <<PK>>
 * organization_id : uuid <<FK>>
 --
 store_key : text
 provider : text
 name : text
 backend_address : text
 workload_address : text
 kv_mount : text
 auth_mount : text
 credential_ref : text
 status : text
}
entity environment_operations {
 * id : uuid <<PK>>
 * environment_id : uuid <<FK>>
 --
 kind : text
 authorization_mode : text
 actor_ref : text
 confirmed_scope : jsonb
 deletion_request_hash : text
 scope_snapshot : jsonb
 owner_instance : text
 fence : bigint
 status : text
 stage : text
 pins : jsonb
 detail : jsonb
 failure : text
 heartbeat_at : timestamptz
 deadline : timestamptz
  review_request_id : uuid <<nullable,scoped unique>>
}
entity applications {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  application_key : text <<UQ>>
  name : text
  subdomain : text
  version : bigint
}
entity environments {
  * id : uuid <<PK>>
  * application_id : uuid <<FK>>
  --
  environment_key : text
  infrastructure_scope : text <<ENVIRONMENT only>>
  secret_store_id : uuid <<FK,nullable>>
  target_generation : bigint
  generation_high : bigint
  active_operation_id : uuid <<FK,nullable>>
  namespace_identity : text
  current_deployment_set_id : uuid <<FK>>
  version : bigint
  draft_version : bigint
  public_routes_pending : boolean
  desired_config_revision_id : uuid <<FK>>
}
entity configuration_revisions {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  version : bigint
  created_at : timestamptz
}
entity configuration_revision_entries {
  * revision_id : uuid <<PK,FK>>
  * key_name : text <<PK>>
  --
  kind : text
  value_ref : text
  store_key : text
  variable_value : text
}
entity workload_drafts {
  * environment_id : uuid <<PK,FK>>
  * workload_id : text <<PK>>
  --
  score_document : jsonb
  state : text
  updated_at : timestamptz
}
entity resource_types {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  resource_type_key : text
  input_schema : jsonb
  output_schema : jsonb
}
entity resource_definitions {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  * resource_type_id : uuid <<FK>>
  --
  definition_key : text
  definition_name : text
  version : bigint <<CAS>>
  driver_type : text
  connection_id : uuid <<FK>>
  driver_inputs : jsonb
  provision_rules : jsonb
}
entity matching_criteria {
  * id : uuid <<PK>>
  * resource_definition_id : uuid <<FK>>
  --
  env_type : text
  app_id : text
  env_id : text
  res_id : text
  class : text
  specificity_score : int
}
entity deployment_sets {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  created_by_deployment_id : uuid <<FK>>
  document : jsonb
  document_hash : text
}
entity deployment_delta_snapshots {
  * id : uuid <<PK>>
  * deployment_id : uuid <<FK,UQ>>
  --
  document : jsonb
  document_hash : text
  metadata : jsonb
  created_at : timestamptz
}
entity deployments {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  action : text
  workload_id : text
  status : text
  base_deployment_set_id : uuid <<FK>>
  candidate_deployment_set_id : uuid <<FK>>
  base_environment_version : bigint
  review_request_id : uuid <<nullable,correlation>>
}
entity deployment_plans {
  * deployment_id : uuid <<PK,FK>>
  --
  resource_graph : jsonb
  matched_definitions : jsonb
  provision_batches : jsonb
  classification : jsonb
  plan_hash : text
  document.review : jsonb <<optional,safe>>
}
entity active_resources {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  * resource_definition_id : uuid <<FK>>
  --
  descriptor : text
  scope_type : text
  scope_id : text
  status : text
  executor_state_ref : jsonb
  outputs : jsonb
  last_deployment_id : uuid <<FK>>
}
entity deployment_resources {
  * deployment_id : uuid <<PK,FK>>
  * node_descriptor : text <<PK>>
  --
  active_resource_id : uuid <<FK>>
  status : text
  batch_index : int
  resolved_inputs : jsonb
  output_snapshot : jsonb
}
entity workload_instances {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  workload_id : text
  last_deployment_id : uuid <<FK>>
  applied_config_revision_id : uuid <<FK>>
  target_ref : jsonb
  manifest_digest : text
  status : text
}
entity deployment_workloads {
  * deployment_id : uuid <<PK,FK>>
  * workload_id : text <<PK>>
  --
  status : text
  target_ref : jsonb
  manifest_digest : text
  applied_config_revision_id : uuid <<FK>>
  observed_at : timestamptz
  manifest_review : jsonb <<nullable,safe>>
}

entity effectiveness_baselines {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  application_id : uuid <<FK, nullable>>
  created_by : uuid <<FK>>
  --
  metric_id : text
  version : bigint
  retired : boolean
  statistic : text
  value_seconds : bigint
  source : text
  sample_size : integer
  measured_from : date
  measured_to : date
  effective_from : date
  created_at : timestamptz
}
note right of effectiveness_baselines
  UC-17 append-only versions; Console SELECT/INSERT only.
  Unique (organization, metric, application-or-organization, version).
end note

organizations ||--o{ effectiveness_baselines
applications |o--o{ effectiveness_baselines : scope
user_accounts ||--o{ effectiveness_baselines : created_by
organizations ||--o{ connections
organizations ||--o{ user_accounts
user_accounts ||--o{ sessions
organizations ||--o{ applications
organizations ||--o{ resource_types
organizations ||--o{ resource_definitions
resource_definitions }o--o| connections : Driver Account
applications ||--o{ environments
environments ||--o{ deployment_sets
environments ||--o{ deployments
environments ||--o{ workload_instances
environments ||--o{ configuration_revisions
environments ||--o{ workload_drafts
environments }o--o| configuration_revisions : desired
configuration_revisions ||--o{ configuration_revision_entries
configuration_revisions ||--o{ workload_instances : applied
configuration_revisions ||--o{ deployment_workloads : applied
environments }o--o| deployment_sets : current
resource_types ||--o{ resource_definitions
resource_definitions ||--|{ matching_criteria
deployments ||--|| deployment_plans
deployments }o--|| deployment_sets : base
deployments }o--|| deployment_sets : candidate
deployments ||--o| deployment_delta_snapshots : delta_snapshot
deployments ||--o{ deployment_resources
deployments ||--o{ deployment_workloads
resource_definitions ||--o{ active_resources
active_resources ||--o{ deployment_resources
deployments ||--o{ active_resources : last
deployments ||--o{ workload_instances : last
organizations ||--o{ secret_store_connections
secret_store_connections ||--o{ environments : selected store
environments ||--o{ environment_operations
entity terraform_module_bundles {
 * id : uuid <<PK>>
 --
 source_id : text
 module_id : text
 revision : text
 content_sha256 : text
 provider_lock_digest : text
 contract : jsonb
}
note right of terraform_module_bundles
  UNIQUE(source_id,module_id,revision,subdirectory)
  One digest per revision/path; immutable after verification.
end note
entity terraform_resource_instances {
 * id : uuid <<PK>>
 * organization_id : uuid <<FK>>
 * environment_id : uuid <<FK>>
 * module_bundle_id : uuid <<FK>>
 --
 target_generation : bigint
 descriptor : text
 scope_type : text
 scope_id : text
 state_key : text <<UQ>>
 active_resource_id : uuid <<FK,nullable>>
 target_ref : jsonb
 physical_intent : jsonb
 created_by_run_id : text
 status : text
}
entity terraform_states {
 * resource_instance_id : uuid <<PK,FK>>
 --
 ciphertext : bytea
 nonce : bytea
 key_id : text
 aad_revision : bigint
 lineage : text
 serial : bigint
 version : bigint
}
entity terraform_state_locks {
 * resource_instance_id : uuid <<PK,FK>>
 * environment_operation_id : uuid <<FK>>
 --
 lock_id : text
 owner : text
 fencing_generation : bigint
 deadline : timestamptz
}
entity terraform_resource_attempts {
 * id : uuid <<PK>>
 * resource_instance_id : uuid <<FK>>
 * environment_operation_id : uuid <<FK>>
 --
 deployment_id : uuid <<FK,nullable>>
 run_id : text
 action : text
 ownership : text
 stage : text
 status : text
 observed_physical_ids : jsonb
}
entity terraform_executor_capabilities {
 * token_hash : text <<PK>>
 * resource_instance_id : uuid <<FK>>
 * environment_operation_id : uuid <<FK>>
 --
 fencing_generation : bigint
 action : text
 expires_at : timestamptz
}
resource_definitions }o--o| terraform_module_bundles : verified ref in inputs
environments ||--o{ terraform_resource_instances
organizations ||--o{ terraform_resource_instances
terraform_module_bundles ||--o{ terraform_resource_instances
active_resources |o--o| terraform_resource_instances
terraform_resource_instances ||--o| terraform_states
terraform_resource_instances ||--o| terraform_state_locks
terraform_resource_instances ||--o{ terraform_resource_attempts
terraform_resource_instances ||--o{ terraform_executor_capabilities
environment_operations ||--o{ terraform_state_locks
environment_operations ||--o{ terraform_resource_attempts
environment_operations ||--o{ terraform_executor_capabilities
deployments |o--o{ terraform_resource_attempts
note right of terraform_states
Restricted encrypted state, not logical outputs.
Encryption key lives outside platform database.
One state per stable instance; no run ID in key.
end note
entity terraform_resource_dependencies {
 * consumer_instance_id : uuid <<PK,FK>>
 * provider_instance_id : uuid <<PK,FK>>
 --
 organization_id : uuid <<FK>>
 environment_id : uuid <<FK>>
 target_generation : bigint
 version : bigint
}
terraform_resource_instances ||--o{ terraform_resource_dependencies : consumer
terraform_resource_instances ||--o{ terraform_resource_dependencies : provider
note right of environment_operations
RESOURCE_CLEANUP persists USER_CONFIRMED or RUN_CLEANUP.
Confirmed root/dependency set and version snapshot immutable.
Token replay cannot create a second operation.
end note
note as V03Placement
ADR-016: plan/module JSON preserves metadata.class and per-workload placement.
Original target_ref/provider pins include scoped cluster and namespace.
Internal execution does not use Environment connection/profile.
Normal existing-cluster Definition FK; cluster ownership PREEXISTING.
Fresh baseline only; no automatic old-state migration/reset.
end note
note as V040506Placement
ADR-017 extends target_ref/plan pins to same-execution EKS.
Typed provider=eks + region and original account identity, no auth bytes.
Final V06.08 design: no Environment deployment-binding/transition fields.
Implementation and acceptance gates tracked separately in CURRENT_STATE.
Secret-store selection, owner/fence and original per-resource targets remain.
end note
@enduml
