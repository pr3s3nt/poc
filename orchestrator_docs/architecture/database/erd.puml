@startuml
title Orchestrator Database ERD
hide circle
skinparam linetype ortho

entity organizations {
  * id : uuid <<PK>>
  --
  organization_key : text <<UQ>>
  name : text
}
entity user_accounts {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  username : text <<UQ>>
  password_hash : text
  role : text
  status : text
}
entity sessions {
  * id : uuid <<PK>>
  * user_account_id : uuid <<FK>>
  --
  token_hash : text <<UQ>>
  expires_at : timestamptz
  revoked_at : timestamptz
}
entity connections {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  connection_key : text
  name : text
  authentication_type : text
  kind : text
  secret_ref : text
  status : text
  config : jsonb
}
entity applications {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  connection_id : uuid <<FK,legacy>>
  --
  name : text
  subdomain : text
  execution_profile : text
  region : text
  runtime_status : text
  version : bigint
  configuration_provider : text
}
entity environments {
  * id : uuid <<PK>>
  * application_id : uuid <<FK>>
  --
  environment_key : text
  connection_id : uuid <<FK,nullable>>
  execution_profile : text
  region : text
  runtime_status : text
  infrastructure_scope : text
  namespace_identity : text
  current_deployment_set_id : uuid <<FK>>
  version : bigint
  draft_version : bigint
  public_routes_pending : boolean
  desired_config_revision_id : uuid <<FK>>
}
entity configuration_revisions {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  version : bigint
  created_at : timestamptz
}
entity configuration_revision_entries {
  * revision_id : uuid <<PK,FK>>
  * key_name : text <<PK>>
  --
  kind : text
  value_ref : text
}
entity workload_drafts {
  * environment_id : uuid <<PK,FK>>
  * workload_id : text <<PK>>
  --
  score_document : jsonb
  state : text
  updated_at : timestamptz
}
entity resource_types {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  --
  resource_type_key : text
  input_schema : jsonb
  output_schema : jsonb
}
entity resource_definitions {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  * resource_type_id : uuid <<FK>>
  --
  definition_key : text
  driver_type : text
  connection_id : uuid <<FK>>
  driver_inputs : jsonb
  provision_rules : jsonb
}
entity matching_criteria {
  * id : uuid <<PK>>
  * resource_definition_id : uuid <<FK>>
  --
  env_type : text
  app_id : text
  env_id : text
  res_id : text
  class : text
  specificity_score : int
}
entity deployment_sets {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  created_by_deployment_id : uuid <<FK>>
  document : jsonb
  document_hash : text
}
entity deployment_delta_snapshots {
  * id : uuid <<PK>>
  * deployment_id : uuid <<FK,UQ>>
  --
  document : jsonb
  document_hash : text
  metadata : jsonb
  created_at : timestamptz
}
entity deployments {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  action : text
  workload_id : text
  status : text
  base_deployment_set_id : uuid <<FK>>
  candidate_deployment_set_id : uuid <<FK>>
  base_environment_version : bigint
}
entity deployment_plans {
  * deployment_id : uuid <<PK,FK>>
  --
  resource_graph : jsonb
  matched_definitions : jsonb
  provision_batches : jsonb
  classification : jsonb
  plan_hash : text
}
entity active_resources {
  * id : uuid <<PK>>
  * organization_id : uuid <<FK>>
  * resource_definition_id : uuid <<FK>>
  --
  descriptor : text
  scope_type : text
  scope_id : text
  status : text
  executor_state_ref : jsonb
  outputs : jsonb
  last_deployment_id : uuid <<FK>>
}
entity deployment_resources {
  * deployment_id : uuid <<PK,FK>>
  * node_descriptor : text <<PK>>
  --
  active_resource_id : uuid <<FK>>
  status : text
  batch_index : int
  resolved_inputs : jsonb
  output_snapshot : jsonb
}
entity workload_instances {
  * id : uuid <<PK>>
  * environment_id : uuid <<FK>>
  --
  workload_id : text
  last_deployment_id : uuid <<FK>>
  applied_config_revision_id : uuid <<FK>>
  target_ref : jsonb
  manifest_digest : text
  status : text
}
entity deployment_workloads {
  * deployment_id : uuid <<PK,FK>>
  * workload_id : text <<PK>>
  --
  status : text
  target_ref : jsonb
  manifest_digest : text
  applied_config_revision_id : uuid <<FK>>
  observed_at : timestamptz
}

organizations ||--o{ connections
organizations ||--o{ user_accounts
user_accounts ||--o{ sessions
organizations ||--o{ applications
organizations ||--o{ resource_types
organizations ||--o{ resource_definitions
applications }o--o| connections : legacy
environments }o--o| connections : set once
applications ||--o{ environments
environments ||--o{ deployment_sets
environments ||--o{ deployments
environments ||--o{ workload_instances
environments ||--o{ configuration_revisions
environments ||--o{ workload_drafts
environments }o--o| configuration_revisions : desired
configuration_revisions ||--o{ configuration_revision_entries
configuration_revisions ||--o{ workload_instances : applied
configuration_revisions ||--o{ deployment_workloads : applied
environments }o--o| deployment_sets : current
resource_types ||--o{ resource_definitions
resource_definitions ||--|{ matching_criteria
deployments ||--|| deployment_plans
deployments }o--|| deployment_sets : base
deployments }o--|| deployment_sets : candidate
deployments ||--o| deployment_delta_snapshots : delta_snapshot
deployments ||--o{ deployment_resources
deployments ||--o{ deployment_workloads
resource_definitions ||--o{ active_resources
active_resources ||--o{ deployment_resources
deployments ||--o{ active_resources : last
deployments ||--o{ workload_instances : last
@enduml
