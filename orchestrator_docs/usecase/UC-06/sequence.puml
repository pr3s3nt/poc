@startuml
title UC-06 - Deploy Workload (shared orchestration)
autonumber
actor Developer
boundary DeploymentController as API
control DeploymentService as Service
control PlanningService as Planner
control ResourceDescriptorParser as DescriptorParser
control ResourceProvisioningService as Provisioner
control OutputBindingResolver as Resolver
control WorkloadRenderer as Renderer
boundary WorkloadDeployer as Deployer
boundary PublicRouteManager as Routes
database DeploymentRepository as DeploymentRepo
database ApplicationRepository as AppRepo
database EnvironmentRepository as EnvRepo
database DeploymentDeltaSnapshotRepository as DeltaSnapshotRepo
database DeploymentSetRepository as SetRepo
database WorkloadInstanceRepository as WorkloadRepo

Developer -> API: DeployWorkload(command)
API -> Service: DeployWorkload(ctx, command)
Service -> EnvRepo: LoadPlanningSnapshot(appID, envID) [MS-01]
EnvRepo --> Service: Snapshot + version + configured Environment Connection/profile/region/scope
Service -> DeploymentRepo: Create(PLANNING, snapshot=NULL)
DeploymentRepo --> Service: Deployment
Service -> Planner: Plan(request) [MS-02..MS-08]
Planner -> DescriptorParser: ParseDescriptorText(reference, node, context) [BR-12]
DescriptorParser --> Planner: Canonical descriptor
Planner --> Service: Plan with Humanitec-shaped Delta\nand typed container resources
alt planning fails before Delta Snapshot
  Service -> DeploymentRepo: MarkFailed(reason, snapshot=NULL)
  Service --> API: Planning error
else plan succeeded
opt Definition-selected score-k8s
  Service -> Renderer: ValidateSelection(pinned Definition/bundle/binary digest) [BR-17]
  Renderer --> Service: available (failure stops before provisioning)
end
Service -> DeltaSnapshotRepo: Save(immutable snapshot) <<transaction A>>
Service -> SetRepo: Save(candidateSet) <<transaction A>>
Service -> DeploymentRepo: SavePlan, attach snapshot, mark PROVISIONING <<transaction A>>
Service -> Provisioner: Provision(plan.ResourceBatches) [MS-09]
Provisioner --> Service: ProvisionResult(outputs, target)
Service -> Resolver: ResolveWorkloadBindings(candidate, outputs) [MS-10]
Resolver --> Service: Resolved workload
Service -> Renderer: Render(resolved workload, pinned selection, target, requests/limits) [MS-11]
Renderer --> Service: Manifests
Service -> Deployer: Apply(target, manifests)
Service -> Deployer: WaitReady(target, workloadRefs)
Deployer --> Service: Ready
opt internal kind, direct deploy
  Service -> Routes: Reconcile full Environment Ingress from Candidate Set
  Routes --> Service: Route applied (kubectl or Fleet _routes bundle)
end
Service -> EnvRepo: CompareVersionAndSetCurrent(version, candidateSet) <<transaction B>> [MS-12]
Service -> WorkloadRepo: UpsertReady(instances) <<transaction B>>
Service -> EnvRepo: MarkRuntimeReadyIfCloud(environmentID) <<transaction B>>
Service -> DeploymentRepo: MarkSucceeded() <<transaction B>>
Service --> API: DeploymentResult [MS-13]
API --> Developer: SUCCEEDED
end

@enduml
