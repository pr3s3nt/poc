@startuml
title VOPC - UC-06 Deploy Workload
left to right direction
skinparam classAttributeIconSize 0
class DeploymentController <<boundary>> {
  +DeployWorkload(command)
}
class DeploymentService <<control>> {
  +DeployWorkload(ctx, cmd): DeploymentResult
}
class PlanningService <<control>> {
  +Plan(ctx, request): DeploymentPlan
}
class ResourceDescriptorParser <<control>> {
  +ParseDescriptorText(raw, current, context): ResourceDescriptor
}
class ResourceProvisioningService <<control>> {
  +Provision(ctx, request): ProvisionResult
}
class OutputBindingResolver <<control>> {
  +ResolveWorkloadBindings(candidate, outputs): ResolvedWorkload
}
interface WorkloadRenderer {
  +Render(ctx, request): List<Manifest>
}
interface WorkloadDeployer {
  +Apply(ctx, target, manifests)
  +WaitReady(ctx, target, workloads)
}
class Deployment <<entity>> {
  +Create(): Deployment
  +StartProvisioning(plan)
  +StartDeploying()
  +Succeed()
}
class DeploymentPlan <<entity>>
class DeploymentDeltaSnapshot <<entity>> {
  +ID: DeltaSnapshotID
  +Metadata: DeltaSnapshotMetadata
  +Modules: ModuleDelta
  +Shared: List<JSONPatchOperation>
}
class DeploymentSet <<entity>>
class ContainerResourceRequirements <<value>> {
  +Requests: ComputeResources
  +Limits: ComputeResources
}
class ComputeResources <<value>> {
  +CPU: string
  +Memory: string
}
class ProvisionResult <<entity>>
interface EnvironmentRepository {
  +LoadPlanningSnapshot(ctx, appID, envID): PlanningSnapshot
  +CompareVersionAndSetCurrent(ctx, envID, version, setID)
}
interface ApplicationRepository {
  +MarkRuntimeReadyIfCloud(ctx, applicationID)
}
interface DeploymentRepository {
  +Create(ctx, deployment)
  +SavePlan(ctx, deploymentID, plan)
  +MarkSucceeded(ctx, deploymentID)
}
interface DeploymentSetRepository {
  +Save(ctx, set)
}
interface DeploymentDeltaSnapshotRepository {
  +Save(ctx, snapshot)
}
interface WorkloadInstanceRepository {
  +UpsertReady(ctx, instances)
}
DeploymentController --> DeploymentService
DeploymentService --> PlanningService
PlanningService --> ResourceDescriptorParser
DeploymentService --> ResourceProvisioningService
DeploymentService --> OutputBindingResolver
DeploymentService --> WorkloadRenderer
DeploymentService --> WorkloadDeployer
DeploymentService --> EnvironmentRepository
DeploymentService --> ApplicationRepository
DeploymentService --> DeploymentRepository
DeploymentService --> DeploymentSetRepository
DeploymentService --> DeploymentDeltaSnapshotRepository
DeploymentService --> WorkloadInstanceRepository
DeploymentService ..> Deployment
DeploymentService ..> DeploymentPlan
DeploymentService ..> DeploymentDeltaSnapshot
DeploymentService ..> DeploymentSet
DeploymentService ..> ProvisionResult
WorkloadRenderer ..> ContainerResourceRequirements
ContainerResourceRequirements *-- ComputeResources
@enduml
