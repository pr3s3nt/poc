@startuml
title VOPC - UC-05 Validate and Preview
left to right direction
skinparam classAttributeIconSize 0
class PreviewController <<boundary>> {
  +PreviewDeployment(query)
}
class PreviewService <<control>> {
  +PreviewDeployment(ctx, query): DeploymentPreview
}
class PlanningService <<control>> {
  +Plan(ctx, request): DeploymentPlan
}
class ScoreConverter <<control>> {
  +ConvertAndValidate(score, resourceTypes): WorkloadFragment
}
class WorkloadSpecValidator <<control>> {
  +ValidateContainerResources(fragment)
}
class BeforeStateValidator <<control>> {
  +Validate(current, workloadID, before)
}
class DeltaBuilder <<control>> {
  +BuildHumanitecDelta(currentSet, workloadID, before, after): DeltaResult
}
class ResourceGraphBuilder <<control>> {
  +BuildAndExpand(candidate, selectedDefinitions, references, rules): ResourceGraph
}
class DefinitionMatcher <<control>> {
  +MatchRemainingResources(graph, context): MatchedDefinitions
}
class DriverContractInspector <<control>> {
  +InspectContracts(graph): Contracts
}
class BatchScheduler <<control>> {
  +Schedule(graph): ProvisionBatches
}
class ActiveResourceClassifier <<control>> {
  +Classify(graph, active): ResourceClassification
}
class DeploymentPlan <<entity>>
class DeploymentPreview <<entity>>
class DeploymentDeltaDocument <<value>> {
  +Modules: ModuleDelta
  +Shared: List<JSONPatchOperation>
}
class ModuleDelta <<value>> {
  +Add: Map<WorkloadID, Module>
  +Remove: List<WorkloadID>
  +Update: Map<WorkloadID, List<JSONPatchOperation>>
}
class ContainerResourceRequirements <<value>> {
  +Requests: ComputeResources
  +Limits: ComputeResources
}
interface PlanningSnapshotRepository {
  +ReadSnapshot(ctx, appID, envID, organization): PlanningSnapshot
}
PreviewController --> PreviewService
PreviewService --> PlanningSnapshotRepository
PreviewService --> PlanningService
PreviewService ..> DeploymentPreview
PlanningService --> ScoreConverter
PlanningService --> WorkloadSpecValidator
PlanningService --> BeforeStateValidator
PlanningService --> DeltaBuilder
PlanningService --> ResourceGraphBuilder
PlanningService --> DefinitionMatcher
PlanningService --> DriverContractInspector
PlanningService --> BatchScheduler
PlanningService --> ActiveResourceClassifier
PlanningService ..> DeploymentPlan
PlanningService ..> DeploymentDeltaDocument
ScoreConverter ..> ContainerResourceRequirements
class RenderBundle <<value>>
class RenderingSelection <<value>>
PlanningService ..> RenderingSelection : deterministic selection + plan hash
RenderingSelection *-- RenderBundle
note right of ResourceGraphBuilder
ADR-017: select workload Definition before fixed point;
expand matched references/provision/provider bindings.
Pin each node account/region and typed consumer placement.
No implicit EKS, Environment target or provider calls in Preview.
end note

class TerraformModuleBundle <<value>>
class ResourceInstanceMetadata <<value>>
PlanningSnapshotRepository ..> TerraformModuleBundle : verified registry only
PlanningSnapshotRepository ..> ResourceInstanceMetadata : stable identity/version
DeploymentPlan ..> TerraformModuleBundle : pinned module/provider digests
@enduml
