@startuml
title UC-05 - Validate and Preview Score Changes
autonumber
actor Developer
boundary PreviewController as API
control PreviewService as Preview
control PlanningService as Planner
control ScoreConverter as Converter
control WorkloadSpecValidator as WorkloadValidator
control BeforeStateValidator as BeforeValidator
control DeltaBuilder as Delta
control ImplicitResourceEnricher as Enricher
control ResourceGraphBuilder as Graph
control DefinitionMatcher as Matcher
control DriverContractInspector as Inspector
control BatchScheduler as Scheduler
database EnvironmentRepository as EnvRepo
database ActiveResourceRepository as ResourceRepo

Developer -> API: PreviewDeployment(query)
API -> Preview: PreviewDeployment(ctx, query)
Preview -> EnvRepo: ReadSnapshot(appID, envID, session Organization) [MS-01]
EnvRepo --> Preview: app + env + profile + current set + version + catalog + active resources
Preview -> Planner: Plan(request)
Planner -> Converter: ConvertAndValidate(before/after Score) [MS-02..MS-03]
Converter --> Planner: Before/after workload fragments
Planner -> WorkloadValidator: ValidateContainerResources(fragments) [MS-02]
WorkloadValidator --> Planner: Typed requests/limits preserved
Planner -> BeforeValidator: Validate(currentSet, workloadID, before) [MS-04]
BeforeValidator --> Planner: valid module + shared contribution
Planner -> Delta: BuildHumanitecDelta(currentSet, workloadID, before, after) [MS-04]
Delta --> Planner: transient DeploymentDeltaDocument + CandidateSet
Planner -> Enricher: Enrich(candidate, profile) [MS-05]
Enricher --> Planner: Implicit resources
Planner -> Graph: BuildAndExpand(candidate, implicit) [MS-05]
Graph -> Matcher: MatchAll(nodes, context)
Matcher --> Graph: Matched definitions
Graph --> Planner: ResourceGraph
Planner -> Inspector: InspectContracts(graph) [MS-06]
Inspector --> Planner: Valid contracts
note right of Planner: Classify using Active Resources\nfrom the same read-only snapshot
Planner -> Scheduler: Schedule(graph) [MS-07]
Scheduler --> Planner: Provider-first batches
Planner --> Preview: DeploymentPlan
Preview --> API: DeploymentPreview [MS-08]
API --> Developer: Preview (no runtime mutation)
@enduml
