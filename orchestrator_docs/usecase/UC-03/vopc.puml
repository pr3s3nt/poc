@startuml
title VOPC - UC-03 Register Resource Definition
left to right direction
skinparam classAttributeIconSize 0
class ResourceDefinitionController <<boundary>> {
  +RegisterResourceDefinition(document)
  +ListRenderBundles(sessionOrg, role)
  +ListDefinitionCapabilities(sessionOrg, role)
}
class ResourceDefinitionService <<control>> {
  +RegisterResourceDefinition(ctx, cmd): ResourceDefinition
  +ListRenderBundles(): SafeBundleMetadata[]
  +ListDefinitionCapabilities(ctx, org): CapabilityMetadata[]
  +PreviewMatching(ctx, org, query): MatchingPreview
}
interface DriverContractInspector {
  +Inspect(module): ModuleContract
}
class ResourceDefinition <<entity>> {
  +Validate()
}
class MatchingCriterion <<entity>> {
  +EnvType: string?
  +AppID: string?
  +EnvID: string?
  +ResID: string?
  +Class: string?
  +Score(context): int
}
interface ResourceTypeRepository {
  +ListResourceTypes(ctx, orgID): List
}
interface ConnectionRepository {
  +GetConnection(ctx, connectionID): Connection
}
interface ResourceDefinitionRepository {
  +ListResourceDefinitions(ctx, orgID): List
  +CreateResourceDefinition(ctx, orgID, definition)
}
ResourceDefinitionController --> ResourceDefinitionService
ResourceDefinitionService --> DriverContractInspector
ResourceDefinitionService --> ResourceTypeRepository
ResourceDefinitionService --> ConnectionRepository
ResourceDefinitionService --> ResourceDefinitionRepository
ResourceDefinitionService ..> ResourceDefinition
ResourceDefinition "1" *-- "1..*" MatchingCriterion
class RenderBundle <<value>>
class RenderingSelection <<value>>
ResourceDefinitionService ..> RenderBundle : installed contract/fingerprint
class DefinitionMatcher <<control>>
ResourceDefinitionService ..> DefinitionMatcher : pure criteria + connection guard
class ModuleSourcePolicy <<control>>
class ModuleBundleResolver <<adapter>>
class TerraformModuleBundle <<entity>>
ResourceDefinitionService --> ModuleSourcePolicy : Admin allowlist
ResourceDefinitionService --> ModuleBundleResolver : verify immutable content before insert
ModuleBundleResolver ..> TerraformModuleBundle
ResourceDefinition --> TerraformModuleBundle : verified bundle ref
@enduml
