@startuml
title VOPC - UC-04 Connections
left to right direction
skinparam classAttributeIconSize 0
class ConnectionController <<boundary>> {
  +InspectKubeconfig(document)
  +RegisterKubeconfig(command)
  +RegisterAWSDriverAccount(command)
  +RegisterEC2Role(command)
}
class ConnectionService <<control>> {
  +RenameAccount(ctx, org, key, expectedVersion, name)
  +VerifyAccount(ctx, org, key, expectedVersion)
  +ReplaceAccountCredential(ctx, org, key, expectedVersion, cmd)
  +InspectKubeconfig(ctx, org, document): ContextMetadata
  +RegisterKubeconfig(ctx, org, cmd): Connection
  +RegisterAWSDriverAccount(ctx, org, cmd): Connection
  +RegisterEC2Role(ctx, org, cmd): Connection
}
class KubeconfigParser <<control>> {
  +Inspect(document): ContextMetadata
  +Normalize(document, context): SelectedCredential
}
class KubernetesConnectionVerifier <<adapter>> {
  +Verify(ctx, selectedCredential): Verification
}
class AWSConnectionVerifier <<adapter>>
class Connection <<entity>> {
  +Version
  +AccountType: AWS or INTERNAL
  +Name
  +Kind
  +AuthenticationType
  +SecretRef
  +Status
}
interface ConnectionCredentialStore {
  +Put(ctx, org, key, credential): Reference
  +Get(ctx, org, key, reference): Credential
  +Delete(ctx, org, key, reference)
}
interface ConnectionRepository {
  +CompareAndSwap(ctx, org, key, expectedVersion, replacement)
  +Create(ctx, connection)
  +FindReady(ctx, org, key): Connection
}
class ConnectionCredentialResolver <<control>> {
  +Resolve(ctx, opaqueTarget): ScopedCredential
}
ConnectionController --> ConnectionService
ConnectionService --> KubeconfigParser
ConnectionService --> ConnectionCredentialStore
ConnectionService --> ConnectionRepository
ConnectionService --> KubernetesConnectionVerifier
ConnectionService --> AWSConnectionVerifier : identity/region/capabilities
ConnectionService ..> Connection
ConnectionCredentialResolver --> ConnectionRepository
ConnectionCredentialResolver --> ConnectionCredentialStore
class SecretStoreController <<boundary>>
class SecretStoreService <<control>>
class VaultStoreVerifier <<adapter>>
class SecretStoreConnection <<entity>>
interface SecretStoreRepository
SecretStoreController --> SecretStoreService
SecretStoreService --> VaultStoreVerifier
SecretStoreService --> SecretStoreRepository
SecretStoreService --> ConnectionCredentialStore : platform credential scope
SecretStoreService ..> SecretStoreConnection
class ComposeSecretStoreBootstrap <<boundary>>
ComposeSecretStoreBootstrap --> SecretStoreService : shared managed-store admission
class EC2RoleProvider <<adapter>> {
  +ResolveEC2Role(ctx, expectedArn, region): TemporaryCredential
  +VerifyEC2Role(ctx, expectedArn, regions): Verification
}
ConnectionService --> EC2RoleProvider : explicit AWS_EC2_ROLE
ConnectionCredentialResolver --> EC2RoleProvider : pinned ARN and RoleId
@enduml
