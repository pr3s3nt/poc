@startuml
title UC-04 - Configure Execution Profile Connections
autonumber
actor "Platform Engineer" as PE
boundary ConnectionController as API
control ConnectionService as Service
boundary SecretStore as Secrets
boundary AWSConnectionVerifier as AWS
boundary KubernetesConnectionVerifier as K8s
database ConnectionRepository as Repo

PE -> API: Register connection [MS-01..MS-02]
alt aws-eks [VAR-01]
  API -> Service: RegisterAWSDriverAccount(ctx, command)
  Service -> AWS: Verify(identity, regions, backend) [MS-03]
  AWS --> Service: VerificationResult
else internal-k8s [VAR-02]
  API -> Service: RegisterKubernetesCluster(ctx, command)
  Service -> K8s: Verify(endpoint, credential) [MS-03]
  K8s --> Service: VerificationResult
end
Service -> Secrets: Put(credentialMaterial) [MS-04]
Secrets --> Service: SecretReference
Service -> Service: Connection.MarkReady()
Service -> Repo: Save(connection) <<transaction>> [MS-05]
Repo --> Service: Connection
Service --> API: Connection READY [MS-06]
API --> PE: Registered
@enduml
