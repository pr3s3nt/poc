@startuml
title VOPC - UC-09 View Deployment Status
left to right direction
skinparam classAttributeIconSize 0
class DeploymentQueryController <<boundary>> {
  +GetDeployment(query)
}
class DeploymentQueryService <<control>> {
  +GetDeployment(ctx, query): DeploymentView
}
class DeploymentViewAssembler <<control>> {
  +Assemble(deployment, set, resources, workloads): DeploymentView
}
class OutputRedactor <<control>> {
  +RedactSecretOutputs(view): DeploymentView
}
class DeploymentView <<entity>>
interface DeploymentRepository {
  +FindScoped(ctx, appID, envID, deploymentID): Deployment
}
interface DeploymentSetRepository {
  +FindSnapshot(ctx, setID): DeploymentSet
}
interface DeploymentResourceRepository {
  +ListByDeployment(ctx, deploymentID): List
}
interface ResourceTypeRepository {
  +ListByOrganization(ctx, organization): List
}
interface DeploymentWorkloadRepository {
  +ListByDeployment(ctx, deploymentID): List
}
DeploymentQueryController --> DeploymentQueryService
DeploymentQueryService --> DeploymentViewAssembler
DeploymentQueryService --> OutputRedactor
DeploymentQueryService --> DeploymentRepository
DeploymentQueryService --> DeploymentSetRepository
DeploymentQueryService --> DeploymentResourceRepository
DeploymentQueryService --> ResourceTypeRepository
DeploymentQueryService --> DeploymentWorkloadRepository
DeploymentQueryService ..> DeploymentView
class ResourceQueryController <<boundary>>
class ResourceQueryService <<control>> {
  +GetResource(ctx, scopedID): ResourceDetail
}
class ResourceCleanupQueryService <<control>> {
  +GetOperation(ctx, scopedID): CleanupProgress
}
interface ResourceInstanceRepository
interface EnvironmentOperationRepository
ResourceQueryController --> ResourceQueryService
ResourceQueryController --> ResourceCleanupQueryService
ResourceQueryService --> ResourceInstanceRepository
ResourceCleanupQueryService --> EnvironmentOperationRepository
note right of ResourceQueryService
Detail includes UNREFERENCED resources after workload removal.
Persisted safe metadata only; no provider refresh.
Mutation belongs to UC-07.
end note
@enduml
