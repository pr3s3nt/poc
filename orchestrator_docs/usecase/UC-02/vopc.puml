@startuml
title VOPC - UC-02 Register Resource Type
left to right direction
skinparam classAttributeIconSize 0
class ResourceTypeController <<boundary>> {
  +RegisterResourceType(document)
}
class ResourceTypeService <<control>> {
  +RegisterResourceType(ctx, cmd): ResourceType
}
class ResourceType <<entity>> {
  +Validate()
  +ValidateInputs(params)
  +ValidateOutputs(outputs)
}
interface ResourceTypeRepository {
  +ListResourceTypes(ctx, orgID): []ResourceType
  +SaveResourceType(ctx, orgID, resourceType)
}
ResourceTypeController --> ResourceTypeService
ResourceTypeService --> ResourceTypeRepository
ResourceTypeService ..> ResourceType
@enduml
