@startuml
title VOPC - UC-01 Create Application
left to right direction
skinparam classAttributeIconSize 0
class ApplicationController <<boundary>> {
  +CreateApplication(command)
}
class ApplicationService <<control>> {
  +CreateApplication(ctx, cmd): Application
}
interface DefaultExecutionTargetResolver {
  +Resolve(ctx, organizationID): ExecutionTarget
}
class Application <<entity>> {
  +Create(generatedID, profile, connection): Application
}
class Environment <<entity>> {
  +Create(application, staging|production): Environment
}
class DeploymentSet <<entity>> {
  +Empty(environmentID): DeploymentSet
}
interface ConnectionRepository {
  +FindReady(ctx, connectionID): Connection
}
interface ApplicationRepository {
  +FindByID(ctx, id): Application
  +Save(ctx, application)
}
interface EnvironmentRepository {
  +Save(ctx, environment)
}
interface DeploymentSetRepository {
  +SaveAndSetCurrent(ctx, set)
}
ApplicationController --> ApplicationService
ApplicationService --> DefaultExecutionTargetResolver
ApplicationService --> ConnectionRepository
ApplicationService --> ApplicationRepository
ApplicationService --> EnvironmentRepository
ApplicationService --> DeploymentSetRepository
ApplicationService ..> Application
ApplicationService ..> Environment
ApplicationService ..> DeploymentSet
Application "1" *-- "0..*" Environment
Environment "1" --> "1" DeploymentSet : current
@enduml
