@startuml
title VOPC - UC-01 Editable Environment destinations
left to right direction
class ApplicationController <<boundary>>
class ApplicationService <<control>> {
 +CreateApplication(name, subdomain)
 +ListApplicationConnections(org): SafeChoices
 +SetConnection(org, app, env, key, expectedVersion): Environment
}
class EnvironmentConnectionController <<boundary>>
class Application <<entity>> {
 +Identity
 +IdentityOnly
}
class Environment <<entity>> {
 +SecretStoreKey
 +TargetGeneration
 +OperationID
 +ConnectionKey
 +ExecutionProfile
 +Region
 +RuntimeStatus
 +InfrastructureScope
 +Version
}
class DeploymentSet <<entity>>
interface ConnectionRepository
interface ApplicationRepository
interface EnvironmentRepository {
 +ChangeConnectionCAS(expectedVersion, target)
}
interface DeploymentSetRepository
ApplicationController --> ApplicationService
EnvironmentConnectionController --> ApplicationService
ApplicationService --> ApplicationRepository
ApplicationService --> EnvironmentRepository
ApplicationService --> DeploymentSetRepository
ApplicationService --> EnvironmentRepository : Version CAS + admission
ApplicationService --> ConnectionRepository
Application "1" *-- "2" Environment
Environment "1" --> "1" DeploymentSet : current
class SecretStoreConnection <<entity>>
class EnvironmentOperation <<entity>>
class EnvironmentTransitionService <<control>>
interface SecretStoreRepository
Environment --> SecretStoreConnection
Environment --> EnvironmentOperation
EnvironmentTransitionService --> EnvironmentRepository
EnvironmentTransitionService --> SecretStoreRepository
@enduml
