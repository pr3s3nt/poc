@startuml
title VOPC - UC-01 Application and Environment metadata (V06 design)
left to right direction
class ApplicationController <<boundary>>
class EnvironmentSettingsController <<boundary>>
class ApplicationService <<control>> {
 +CreateApplication(name, subdomain)
}
class EnvironmentSettingsService <<control>>
class ConfigurationService <<control>>
class Application <<entity>> {
 +Identity
 +Version
}
class Environment <<entity>> {
 +SecretStoreKey
 +Version
 +CurrentSet
 +NamespaceIdentity
}
class DeploymentSet <<entity>>
class SecretStoreConnection <<entity>>
class EnvironmentOperation <<entity>>
interface ApplicationRepository
interface EnvironmentRepository
interface DeploymentSetRepository
interface SecretStoreRepository
interface EnvironmentOperationRepository
ApplicationController --> ApplicationService
ApplicationService --> ApplicationRepository
ApplicationService --> EnvironmentRepository
ApplicationService --> DeploymentSetRepository
EnvironmentSettingsController --> EnvironmentSettingsService
EnvironmentSettingsService --> ConfigurationService : immutable copy
EnvironmentSettingsService --> EnvironmentRepository : metadata CAS
EnvironmentSettingsService --> SecretStoreRepository
EnvironmentSettingsService --> EnvironmentOperationRepository : owner/fence
Application "1" *-- "2" Environment
Environment --> DeploymentSet : current
Environment --> SecretStoreConnection
Environment --> EnvironmentOperation
note bottom of Environment
Placement/account/region are per-resource pins (ADR-017).
No Environment deployment binding or transition entry.
end note
@enduml
