@startuml
title VOPC - UC-07 Update or Remove Workload
left to right direction
skinparam classAttributeIconSize 0
class DeploymentController <<boundary>> {
  +UpdateWorkload(command)
  +RemoveWorkload(command)
}
class DeploymentService <<control>> {
  +UpdateWorkload(ctx, cmd): DeploymentResult
  +RemoveWorkload(ctx, cmd): DeploymentResult
}
class PlanningService <<control>> {
  +Plan(ctx, request): DeploymentPlan
}
class BeforeStateValidator <<control>> {
  +Validate(current, workloadID, before)
}
class DeltaBuilder <<control>> {
  +BuildHumanitecDelta(current, workloadID, before, after): DeltaResult
}
class DeploymentDeltaSnapshot <<entity>> {
  +Modules: ModuleDelta
  +Shared: List<JSONPatchOperation>
}
class ModuleDelta <<value>> {
  +Add: Map<WorkloadID, Module>
  +Remove: List<WorkloadID>
  +Update: Map<WorkloadID, List<JSONPatchOperation>>
}
class ResourceProvisioningService <<control>> {
  +Provision(ctx, request): ProvisionResult
}
interface WorkloadDeployer {
  +Apply(ctx, target, manifests)
  +Delete(ctx, target, workloadRef)
  +WaitReady(ctx, target, workloads)
}
class ActiveResource <<entity>> {
  +MarkUnreferenced(deploymentID)
}
interface ActiveResourceRepository {
  +MarkUnreferenced(ctx, descriptors, deploymentID)
}
interface EnvironmentRepository {
  +LoadPlanningSnapshot(ctx, appID, envID): PlanningSnapshot
  +CompareVersionAndSetCurrent(ctx, envID, version, setID)
}
interface DeploymentRepository {
  +Create(ctx, deployment)
  +MarkSucceeded(ctx, deploymentID)
}
interface DeploymentDeltaSnapshotRepository {
  +Save(ctx, snapshot)
}
interface DeploymentSetRepository {
  +Save(ctx, set)
}
DeploymentController --> DeploymentService
DeploymentService --> PlanningService
PlanningService --> BeforeStateValidator
PlanningService --> DeltaBuilder
DeltaBuilder ..> DeploymentDeltaSnapshot
DeploymentDeltaSnapshot *-- ModuleDelta
DeploymentService --> ResourceProvisioningService
DeploymentService --> WorkloadDeployer
DeploymentService --> ActiveResourceRepository
DeploymentService --> EnvironmentRepository
DeploymentService --> DeploymentRepository
DeploymentService --> DeploymentDeltaSnapshotRepository
DeploymentService --> DeploymentSetRepository
DeploymentService ..> ActiveResource
class ResourceCleanupController <<boundary>>
class CleanupPlanner <<control>> {
  +PrepareDeletion(ctx, scopedRoot): ConfirmedScopePreview
}
class ResourceCleanupService <<control>> {
  +CleanupResources(ctx, confirmedToken, typedName): CleanupOperation
}
class EnvironmentOperationManager <<control>>
class ResourceCleanupOperation <<entity>>
interface ResourceInstanceRepository
ResourceCleanupController --> CleanupPlanner : PE/Admin role gate
ResourceCleanupController --> ResourceCleanupService : exact name + pinned token
CleanupPlanner --> ResourceInstanceRepository : candidates/consumer blockers/selected-set validation
ResourceCleanupService --> EnvironmentOperationManager : atomic claim/fencing
ResourceCleanupService --> ResourceInstanceRepository : original state/target + proof
ResourceCleanupService ..> ResourceCleanupOperation
note right of ResourceCleanupService
UNREFERENCED root + no external consumer.
Only user-selected valid set; never add items or platform.
Separate from RemoveWorkload.
end note
@enduml
